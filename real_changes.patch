+    const btn = document.getElementById('submitBtn');
+
+    // Подсветить незаполненные обязательные документы
+    let hasUnuploaded = false;
+    document.querySelectorAll('.auto-doc-upload.doc-required').forEach(input => {
+        const docId = input.dataset.docId;
+        const statusEl = document.getElementById('docStatus_' + docId);
+        const currentStatus = statusEl ? statusEl.textContent.trim() : '';
+        // Если файл не выбран и статус всё ещё "pending" — выделяем
+        if (!input.files.length && statusEl && statusEl.className.includes('st-pending')) {
+            input.classList.add('doc-required-border');
+            hasUnuploaded = true;
+        }
+    });
+
+    if (hasUnuploaded) {
+        if (errorEl) {
+            errorEl.style.display = 'block';
+            errorEl.textContent = '⚠️ Загрузите все обязательные документы (отмечены красной рамкой) перед отправкой заявки.';
+        }
+        return;
+    }
+
+    if (errorEl) errorEl.style.display = 'none';
+    if (btn) btn.disabled = true;
+
+    fetch('{% url "applications:submit" application.id %}', {
+        method: 'POST',
+        headers: { 'X-Requested-With': 'XMLHttpRequest', 'X-CSRFToken': getCookie('csrftoken') },
+    })
+    .then(r => r.json())
+    .then(data => {
+        if (data.success) {
+            window.location.reload();
+        } else if (data.error === 'missing_docs') {
+            if (errorEl) {
+                errorEl.style.display = 'block';
+                errorEl.textContent = '⚠️ Не загружены обязательные документы: ' + data.missing.join(', ');
+            }
+            if (btn) btn.disabled = false;
+        } else {
+            showAlert('error', data.error || 'Ошибка отправки заявки.');
+            if (btn) btn.disabled = false;
+        }
+    })
+    .catch(() => {
+        showAlert('error', 'Ошибка сети.');
+        if (btn) btn.disabled = false;
+    });
+}
 </script>
