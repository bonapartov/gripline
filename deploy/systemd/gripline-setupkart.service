# API приложения GripLine SetupKart (/api/setupkart/ — справочник, синхронизация, вход).
# Отдельный gunicorn, чтобы запросы приложения не занимали воркеры сайта (gripline.service).
# Тот же код и настройки, что у сайта; кэш файловый, сессии в БД — коды входа и лимиты общие.
# Один воркер с потоками: воркер ~220 МБ, на сервере 1,8 ГБ — второй процесс не помещается.
# --no-control-socket: путь управляющего сокета gunicorn общий с gripline.service — второй процесс его перехватывал.
# nginx: location /api/setupkart/ → 127.0.0.1:8002 (deploy/nginx/setupkart.conf).
# Установка: cp deploy/systemd/gripline-setupkart.service /etc/systemd/system/
#            systemctl daemon-reload && systemctl enable --now gripline-setupkart
[Unit]
Description=Gripline SetupKart API (gunicorn)
After=network.target postgresql.service

[Service]
Type=notify
User=root
Group=root
WorkingDirectory=/www/wwwroot/gripline.ru
Environment="PATH=/www/wwwroot/gripline.ru/venv/bin"
Environment="DJANGO_SETTINGS_MODULE=mysite.settings.prod"
ExecStart=/www/wwwroot/gripline.ru/venv/bin/gunicorn --workers 1 --threads 4 --worker-class gthread --timeout 60 --no-control-socket --max-requests 2000 --max-requests-jitter 200 --bind 127.0.0.1:8002 mysite.wsgi:application
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gripline-setupkart

[Install]
WantedBy=multi-user.target
