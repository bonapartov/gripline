[Unit]
Description=Gripline FastAPI — мобильный API
After=network.target postgresql.service gripline.service

[Service]
User=www
Group=www
WorkingDirectory=/www/wwwroot/gripline.ru/fastapi
Environment="PYTHONPATH=/www/wwwroot/gripline.ru/fastapi"
EnvironmentFile=/www/wwwroot/gripline.ru/.env
ExecStart=/www/wwwroot/gripline.ru/fastapi/venv/bin/uvicorn main:app \
    --host 127.0.0.1 \
    --port 8001 \
    --workers 2 \
    --log-level info
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
